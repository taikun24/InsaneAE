    "IOPortBlockEntityMixin",
    "MolecularAssemblerBlockEntityMixin",
    "PatternProviderMenuMixin",
    "compat.AAEQuantumCrafterMixin",
    "compat.AAEReactionChamberMixin",
    "compat.AdvCraftingCpuLogicMixin",
    "compat.ExCircuitCutterMixin",
    "compat.ExCraftingThreadMixin",
    "compat.ExCrystalAssemblerMixin",
    "compat.ExFormationPlaneMixin",
    "compat.ExIOPortMixin",
    "compat.ExInscriberThreadMixin"
  ],
  "client": [
    "ScreenStyleMixin"
  ],
  "injectors": {
    "defaultRequire": 0
  }
}
