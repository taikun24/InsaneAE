{
  "_comment": "他 Mod と共存するための Mixin (加速カードの速度倍率 + 画面スタイルの寛容化 + クラフト CPU の 1 tick 予算の long 化)。required=false なので、注入に失敗してもログにエラーが出るだけでゲームは起動する (その機能が効かなくなるだけ)。壊れると危険な容量系・スレッド上限系は insaneae.mixins.json のまま required=true。",
  "required": false,
  "minVersion": "0.8",
  "package": "jp.main.taikun.insaneae.mixin",
  "compatibilityLevel": "JAVA_17",
  "refmap": "insaneae.refmap.json",
  "priority": 1500,
  "mixins": [
    "CraftingCpuBudgetMixin",
    "CraftingTreeNodeMixin",
    "CraftingTreeProcessInvoker",
    "InscriberBlockEntityMixin",
    "IOBusPartMixin",
    "IOPortBlockEntityMixin",
    "MolecularAssemblerBlockEntityMixin",
    "PatternProviderMenuMixin"
  ],
  "client": [
    "ScreenStyleMixin"
  ],
  "injectors": {
    "defaultRequire": 0
  }
}
