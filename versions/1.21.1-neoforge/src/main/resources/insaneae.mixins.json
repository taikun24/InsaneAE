{
  "required": true,
  "minVersion": "0.8",
  "package": "jp.main.taikun.insaneae.mixin",
  "compatibilityLevel": "JAVA_21",
  "_comment": "壊れると危険な注入 (容量・スレッド上限・ツールチップ) はこちら。required=true なので失敗したら起動時に落ちる。NeoForge は実行時も Mojang 公式マッピングなので refmap は不要。",
  "mixins": [
    "cell.BasicCellInventoryMixin",
    "cell.BasicCellInventoryUuidMixin",
    "cpu.CraftingCPUClusterMixin",
    "cpu.CraftingCPUNameMixin",
    "cpu.CraftingCpuLogicMixin",
    "cpu.CraftingCpuLogicBulkMixin",
    "crafting.CraftingServicePatternFlushMixin",
    "iface.ConfigInventoryAccessor",
    "cpu.CraftingCpuClusterAccessor",
    "cpu.CraftingCpuClusterOwnerMixin",
    "cpu.CraftingServiceQuantumCpuMixin",
    "cpu.CraftingCpuLogicJobAccessor",
    "cpu.CraftingUnitThreadLimitMixin",
    "cpu.ElapsedTimeTrackerInvoker",
    "cpu.ExecutingCraftingJobAccessor",
    "cable.GridNodeChannelMixin",
    "crafting.PatternProviderLogicAccessor",
    "ui.SlotAccessor",
    "cpu.TaskProgressAccessor",
    "ui.TooltipsMixin"
  ],
  "client": [
    "cpu.BigIntegerCPUSelectionListMixin",
    "cable.CableBuilderMixin",
    "cable.CableBusBakedModelMixin",
    "cable.CableBusContainerRenderStateMixin",
    "cable.CableBusRenderStateMixin",
    "cable.CubeBuilderMixin"
  ],
  "injectors": {
    "defaultRequire": 1
  },
  "overwrites": {
    "requireAnnotations": true
  }
}
